# ==============================================
# OmniStock Enterprise WMS - Environment Config Template
# ==============================================

# Database Config
POSTGRES_USER=omnistock_admin
POSTGRES_PASSWORD=omnistock_secret_2026!
POSTGRES_DB=omnistock_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://omnistock_admin:omnistock_secret_2026!@postgres:5432/omnistock_db
DATABASE_LOCAL_URL=postgresql://omnistock_admin:omnistock_secret_2026!@localhost:5432/omnistock_db

# Auth Service (Bun + Hono + Better Auth)
AUTH_PORT=4000
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here
BETTER_AUTH_URL=http://localhost:4000
JWT_ISSUER=omnistock-auth-service
JWT_AUDIENCE=omnistock-core-service

# Core Service (Java Spring Boot)
CORE_PORT=8080

# Frontend (Angular 19)
FRONTEND_PORT=4200
